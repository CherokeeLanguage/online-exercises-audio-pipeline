                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Gohigi tsigesv, digelisgi danindegv kilo tsuwenvsv ale yigi analsgisge'i ale daninogisge'i</ANNOTATION_VALUE>
