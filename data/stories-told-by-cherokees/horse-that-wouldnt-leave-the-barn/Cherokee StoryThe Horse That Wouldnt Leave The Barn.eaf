        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Ale Usdi eligwu akilvdodi nulstane, hatlvgwu yuwena, nasgi usdi akilvdisge'i</ANNOTATION_VALUE>
